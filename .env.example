# Application Environment (development | production | test)
NODE_ENV=development

# HTTP Server Port
PORT=3000

# PostgreSQL Connection URL via PgBouncer (without credentials; password is provided via DB_PASSWORD_PATH)
DB_URL=postgresql://postgres@127.0.0.1:6432/broker_db

# File path to the secret containing the PostgreSQL password
DB_PASSWORD_PATH=./secrets/db_password

# RabbitMQ Broker Connection URL
BROKER_URL=amqp://app:app@127.0.0.1:5672

# Redis Cache Connection URL (maxmemory + allkeys-lru)
REDIS_URL=redis://127.0.0.1:6379

# Redis Queue & Session Connection URL (noeviction + AOF everysec)
REDIS_QUEUE_URL=redis://127.0.0.1:6380

# Auth & JWT Signing Secrets (provided via Vault / scripts/with-secrets.sh; NO defaults in code)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=
JWT_KID=dev-1
JWT_ISSUER=paper-trading-broker-api
JWT_AUDIENCE=paper-trading-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

{
  "name": "paper-trading-broker-api",
  "version": "1.0.0",
  "description": "Paper Trading Broker API (Course Project)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:criteria": "npm run bundle:spec && node --no-warnings --experimental-strip-types test/check-criteria.ts",
    "test": "npm run lint:spec && npm run check:criteria && node --no-warnings --experimental-strip-types test/run-all-tests.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "express-openapi-validator": "^5.6.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@redocly/cli": "^2.46.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}

{
  "name": "paper-trading-broker-api",
  "version": "1.0.0",
  "description": "Paper Trading Broker API (Course Project)",
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/src/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/src/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/src/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/src/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/src/seed.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/src/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/src/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/src/demo-retry.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/src/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/src/report.js",
    "backup": "bash scripts/with-secrets.sh dev bash scripts/backup.sh",
    "restore:drill": "bash scripts/with-secrets.sh dev bash scripts/restore-drill.sh",
    "check:env": "node scripts/check-env-example.mjs",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:criteria": "npm run bundle:spec && node --no-warnings --experimental-strip-types test/check-criteria.ts",
    "test": "npm run lint:spec && npm run check:criteria && node --no-warnings --experimental-strip-types test/run-all-tests.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@redocly/cli": "^2.46.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  }
}

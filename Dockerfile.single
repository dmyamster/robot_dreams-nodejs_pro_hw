# Одностадійний образ без multi-stage (для порівняння розмірів у README)
FROM node:22

WORKDIR /app

# Копіювання всього одразу
COPY . .

# Встановлення всіх залежностей включно з dev-залежностями
RUN npm install

# Компіляція TypeScript
RUN npm run build

EXPOSE 3000

CMD ["node", "dist/index.js"]
